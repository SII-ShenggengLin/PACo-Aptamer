models/
*.pt
*.pth
*.ckpt
*.safetensors

# ── Third-party tool repos cloned with their own git remotes (see README for URLs) ──
tools/*
!tools/TACoAptamer/
!tools/USalign/

# ── Scratch space ──
tmp/

# Environment / secrets
.env

